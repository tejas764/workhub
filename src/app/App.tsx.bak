            {sections.map(s => (
              <button key={s} onClick={() => setSection(s)}
                className={cn("w-full text-left px-3 py-2.5 rounded-lg text-sm font-medium transition-colors",
                  s === section ? "bg-gray-900 text-white" : "text-gray-600 hover:bg-gray-50")}>
                {s}
