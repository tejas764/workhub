                  <p className="text-xs text-gray-400 mt-1">anita.sharma@college.edu</p>
                </div>
              </div>
            </Card>
            <Card className="p-5">
              <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Coordinator</p>
