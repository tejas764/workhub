          <p className="text-sm text-gray-500 mt-0.5">Monday, 30 June 2026 · Faculty · Computer Science</p>
        </div>
        <div className="flex gap-3">
          <Btn variant="outline" size="sm" icon={Upload} onClick={() => onPage("documents")}>Upload Document</Btn>
        </div>
      </div>

      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <StatCard label="My Tasks" value={6} sub="2 overdue" icon={CheckSquare} />
        <StatCard label="My Meetings" value={3} sub="Next: Jul 3" icon={Video} />
