        </Card>

        {/* Team Tasks */}
        <Card className="p-5 lg:col-span-1">
          <SectionHeader title="Team Task Overview" action={
            <Btn variant="ghost" size="sm" onClick={() => onPage("tasks")}>View all <ArrowRight size={12} /></Btn>
          } />
          <div className="space-y-3">
            {TASKS_DATA.slice(0, 5).map(t => (
              <div key={t.id} className="flex items-center gap-3">
                <Avatar name={t.assignee} size="sm" />
                <div className="flex-1 min-w-0">
                  <p className="text-xs font-medium text-gray-800 truncate">{t.title}</p>
                  <p className="text-[10px] text-gray-400">{t.assignee} · Due {t.dueDate}</p>
                </div>
                <StatusBadge status={t.status} />
              </div>
            ))}
          </div>
        </Card>

        {/* Recent Uploads + AI Recommendations */}
        <div className="space-y-4">
          <Card className="p-5">
            <SectionHeader title="Recent Uploads" action={
              <Btn variant="ghost" size="sm" onClick={() => onPage("documents")}>All docs <ArrowRight size={12} /></Btn>
            } />
            <div className="space-y-2">
              {DOCUMENTS_DATA.slice(0, 4).map(d => (
                <div key={d.id} className="flex items-center gap-2.5 py-1.5">
                  <FileIcon type={d.type} />
                  <div className="min-w-0">
                    <p className="text-xs font-medium text-gray-800 truncate">{d.title}</p>
                    <p className="text-[10px] text-gray-400">{d.size} · {d.date}</p>
                  </div>
                </div>
              ))}
            </div>
          </Card>
          <Card className="p-4 bg-gray-50">
            <div className="flex items-center gap-2 mb-2">
              <Bot size={13} className="text-gray-500" />
              <p className="text-xs font-semibold text-gray-700">AI Recommendations</p>
            </div>
            <div className="space-y-1.5">
              {["2 tasks are nearing their deadlines", "Consider rescheduling July 5 meeting — 3 conflicts", "5 documents pending AI summary generation"].map((r, i) => (
                <p key={i} className="text-xs text-gray-600">· {r}</p>
              ))}
            </div>
          </Card>
        </div>
      </div>
    </div>
  );
}

