          <SectionHeader title="My Assigned Tasks" action={
            <Btn variant="ghost" size="sm" onClick={() => onPage("tasks")}>View all <ArrowRight size={12} /></Btn>
          } />
          <div className="space-y-3">
            {TASKS_DATA.filter(t => t.assignee === "Dr. Priya Nair").map(t => (
              <div key={t.id} className="p-3 rounded-xl border border-gray-100 bg-gray-50 hover:bg-gray-100 transition-colors">
                <div className="flex items-start justify-between gap-3 mb-2">
                  <p className="text-sm font-semibold text-gray-800">{t.title}</p>
                  <PriorityBadge priority={t.priority} />
