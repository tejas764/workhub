      <Tabs tabs={["Overview", "Coordinator", "Faculty", "Statistics", "Activity"]} active={tab} onChange={setTab} />

      {tab === "Overview" && (
        <div className="grid grid-cols-3 gap-4">
          <div className="col-span-2 space-y-4">
