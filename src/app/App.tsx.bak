// ─── Utilities ─────────────────────────────────────────────────────────────
function cn(...classes: (string | false | undefined | null)[]) {
  return classes.filter(Boolean).join(" ");
}

function initials(name: string) {
  return name.split(" ").slice(0, 2).map(n => n[0]).join("").toUpperCase();
}

// ─── UI Primitives ─────────────────────────────────────────────────────────

function Avatar({ name, size = "md", className }: { name: string; size?: "sm" | "md" | "lg" | "xl"; className?: string }) {
  const sizes = { sm: "w-7 h-7 text-xs", md: "w-9 h-9 text-sm", lg: "w-12 h-12 text-base", xl: "w-20 h-20 text-xl" };
  return (
    <div className={cn("rounded-full bg-gray-200 border border-gray-300 flex items-center justify-center font-semibold text-gray-600 flex-shrink-0", sizes[size], className)}>
      {initials(name)}
    </div>
  );
}

function StatusBadge({ status }: { status: string }) {
  const map: Record<string, string> = {
    "Active": "bg-gray-900 text-white",
    "On Leave": "bg-gray-400 text-white",
    "Inactive": "bg-gray-200 text-gray-600",
    "Upcoming": "bg-gray-800 text-white",
    "Completed": "bg-gray-300 text-gray-800",
    "Cancelled": "bg-gray-100 text-gray-500",
    "In Progress": "bg-gray-700 text-white",
    "Pending": "bg-gray-200 text-gray-700",
    "Overdue": "bg-gray-900 text-white",
  };
  return <span className={cn("px-2 py-0.5 rounded-full text-xs font-medium", map[status] ?? "bg-gray-100 text-gray-600")}>{status}</span>;
}

function PriorityBadge({ priority }: { priority: string }) {
  const map: Record<string, string> = {
    High: "border border-gray-800 text-gray-800",
    Medium: "border border-gray-500 text-gray-600",
    Low: "border border-gray-300 text-gray-500",
  };
  return <span className={cn("px-2 py-0.5 rounded text-xs font-medium", map[priority])}>{priority}</span>;
}

function CategoryBadge({ label }: { label: string }) {
  return <span className="px-2 py-0.5 rounded bg-gray-100 text-gray-600 text-xs font-medium">{label}</span>;
}

function Btn({
  children, variant = "primary", size = "md", onClick, className, icon: Icon, disabled
}: {
  children?: React.ReactNode; variant?: "primary" | "secondary" | "ghost" | "outline" | "danger";
  size?: "sm" | "md" | "lg"; onClick?: () => void; className?: string;
  icon?: React.FC<{ size?: number }>; disabled?: boolean;
}) {
  const base = "inline-flex items-center gap-2 font-medium rounded-lg transition-colors cursor-pointer select-none";
  const sizes = { sm: "px-3 py-1.5 text-xs", md: "px-4 py-2 text-sm", lg: "px-5 py-2.5 text-sm" };
  const variants = {
    primary: "bg-gray-900 text-white hover:bg-gray-700",
    secondary: "bg-gray-100 text-gray-800 hover:bg-gray-200 border border-gray-200",
    ghost: "text-gray-600 hover:bg-gray-100",
    outline: "border border-gray-300 text-gray-700 hover:bg-gray-50",
    danger: "bg-gray-800 text-white hover:bg-gray-700",
  };
  return (
    <button onClick={onClick} disabled={disabled}
      className={cn(base, sizes[size], variants[variant], disabled && "opacity-50 cursor-not-allowed", className)}>
      {Icon && <Icon size={14} />}
      {children}
    </button>
  );
}

function Input({
  placeholder, value, onChange, type = "text", className, icon: Icon
}: {
  placeholder?: string; value?: string; onChange?: (v: string) => void;
  type?: string; className?: string; icon?: React.FC<{ size?: number; className?: string }>;
}) {
  return (
    <div className={cn("relative", className)}>
      {Icon && <Icon size={15} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" />}
      <input type={type} placeholder={placeholder} value={value} onChange={e => onChange?.(e.target.value)}
        className={cn("w-full border border-gray-200 bg-gray-50 rounded-lg text-sm text-gray-800 placeholder-gray-400 outline-none focus:ring-2 focus:ring-gray-300 focus:border-gray-400",
          Icon ? "pl-9 pr-3 py-2" : "px-3 py-2")} />
    </div>
  );
}

function Select({ options, value, onChange, className }: {
  options: string[]; value?: string; onChange?: (v: string) => void; className?: string;
}) {
  return (
    <select value={value} onChange={e => onChange?.(e.target.value)}
      className={cn("border border-gray-200 bg-gray-50 rounded-lg text-sm text-gray-700 px-3 py-2 outline-none cursor-pointer focus:ring-2 focus:ring-gray-300", className)}>
      {options.map(o => <option key={o}>{o}</option>)}
    </select>
  );
}

function Card({ children, className, onClick }: { children: React.ReactNode; className?: string; onClick?: () => void }) {
  return (
    <div onClick={onClick} className={cn("bg-white border border-gray-200 rounded-xl shadow-sm", className, onClick && "cursor-pointer hover:shadow-md transition-shadow")}>
      {children}
    </div>
  );
}

function SectionHeader({ title, subtitle, action }: { title: string; subtitle?: string; action?: React.ReactNode }) {
  return (
    <div className="flex items-start justify-between mb-4">
      <div>
        <h2 className="text-lg font-semibold text-gray-900">{title}</h2>
        {subtitle && <p className="text-sm text-gray-500 mt-0.5">{subtitle}</p>}
      </div>
      {action}
    </div>
  );
}

function Skeleton({ className }: { className?: string }) {
  return <div className={cn("bg-gray-100 rounded animate-pulse", className)} />;
}

function EmptyState({ icon: Icon, title, description, action }: {
  icon: React.FC<{ size?: number; className?: string }>; title: string; description: string; action?: React.ReactNode;
}) {
  return (
    <div className="flex flex-col items-center justify-center py-16 text-center">
      <div className="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <Icon size={28} className="text-gray-400" />
      </div>
      <h3 className="text-base font-semibold text-gray-800 mb-1">{title}</h3>
      <p className="text-sm text-gray-500 max-w-xs mb-4">{description}</p>
      {action}
    </div>
  );
}

function StatCard({ label, value, sub, icon: Icon }: { label: string; value: string | number; sub?: string; icon: React.FC<{ size?: number; className?: string }> }) {
  return (
    <Card className="p-5">
      <div className="flex items-start justify-between mb-3">
        <p className="text-sm text-gray-500 font-medium">{label}</p>
        <div className="w-9 h-9 rounded-lg bg-gray-100 flex items-center justify-center">
          <Icon size={18} className="text-gray-600" />
        </div>
      </div>
      <p className="text-3xl font-bold text-gray-900">{value}</p>
      {sub && <p className="text-xs text-gray-400 mt-1">{sub}</p>}
    </Card>
  );
}

function FilterBar({ children }: { children: React.ReactNode }) {
  return <div className="flex flex-wrap items-center gap-3 mb-5 bg-white border border-gray-200 rounded-xl p-3 shadow-sm">{children}</div>;
}

function Tabs({ tabs, active, onChange }: { tabs: string[]; active: string; onChange: (t: string) => void }) {
  return (
    <div className="flex border-b border-gray-200 mb-5">
      {tabs.map(t => (
        <button key={t} onClick={() => onChange(t)}
          className={cn("px-4 py-2.5 text-sm font-medium border-b-2 transition-colors -mb-px",
            t === active ? "border-gray-900 text-gray-900" : "border-transparent text-gray-500 hover:text-gray-700")}>
          {t}
        </button>
      ))}
    </div>
  );
}

function ChartCard({ title, children, action }: { title: string; children: React.ReactNode; action?: React.ReactNode }) {
  return (
    <Card className="p-5">
      <div className="flex items-center justify-between mb-4">
        <h3 className="text-sm font-semibold text-gray-800">{title}</h3>
        {action ?? <MoreHorizontal size={16} className="text-gray-400 cursor-pointer" />}
      </div>
      {children}
    </Card>
  );
}

function Pagination({ current, total, onChange }: { current: number; total: number; onChange: (p: number) => void }) {
  return (
    <div className="flex items-center justify-between mt-5 pt-4 border-t border-gray-100">
      <p className="text-xs text-gray-500">Showing {((current - 1) * 10) + 1}–{Math.min(current * 10, total)} of {total}</p>
      <div className="flex items-center gap-1">
        <Btn variant="ghost" size="sm" onClick={() => onChange(Math.max(1, current - 1))} disabled={current === 1}><ChevronLeft size={14} /></Btn>
        {[...Array(Math.ceil(total / 10))].map((_, i) => (
          <button key={i} onClick={() => onChange(i + 1)}
            className={cn("w-8 h-8 rounded text-xs font-medium", i + 1 === current ? "bg-gray-900 text-white" : "text-gray-600 hover:bg-gray-100")}>
            {i + 1}
          </button>
        ))}
        <Btn variant="ghost" size="sm" onClick={() => onChange(Math.min(Math.ceil(total / 10), current + 1))}><ChevronRight size={14} /></Btn>
      </div>
    </div>
  );
}

function FileIcon({ type }: { type: string }) {
  const map: Record<string, string> = {
    pdf: "bg-gray-800 text-white", doc: "bg-gray-600 text-white",
    xlsx: "bg-gray-500 text-white", ppt: "bg-gray-400 text-gray-900",
    img: "bg-gray-300 text-gray-700",
  };
  return (
    <div className={cn("w-10 h-12 rounded-lg flex flex-col items-center justify-center text-[10px] font-bold uppercase", map[type] ?? "bg-gray-100 text-gray-500")}>
      <File size={16} className="mb-0.5" />
      {type}
    </div>
  );
}

function NotifIcon({ type }: { type: string }) {
  const icons: Record<string, React.FC<{ size?: number; className?: string }>> = {
    announcement: Megaphone, task: CheckSquare, meeting: Video, document: FileText, ai: Sparkles
  };
  const Icon = icons[type] ?? Bell;
  return (
    <div className="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
      <Icon size={16} className="text-gray-600" />
    </div>
  );
}

function Modal({ title, onClose, children, footer }: {
  title: string; onClose: () => void; children: React.ReactNode; footer?: React.ReactNode;
}) {
  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      <div className="absolute inset-0 bg-black/30 backdrop-blur-sm" onClick={onClose} />
      <div className="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 z-10">
        <div className="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 className="font-semibold text-gray-900">{title}</h3>
          <button onClick={onClose} className="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center">
            <X size={16} className="text-gray-500" />
          </button>
        </div>
        <div className="px-6 py-4 max-h-[60vh] overflow-y-auto">{children}</div>
        {footer && <div className="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">{footer}</div>}
      </div>
    </div>
  );
}

function Drawer({ title, onClose, children, width = "w-96" }: {
  title: string; onClose: () => void; children: React.ReactNode; width?: string;
}) {
  return (
    <div className="fixed inset-0 z-50 flex">
      <div className="absolute inset-0 bg-black/20" onClick={onClose} />
      <div className={cn("relative ml-auto bg-white shadow-2xl flex flex-col", width)}>
        <div className="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h3 className="font-semibold text-gray-900">{title}</h3>
          <button onClick={onClose} className="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center">
            <X size={16} className="text-gray-500" />
          </button>
        </div>
        <div className="flex-1 overflow-y-auto p-5">{children}</div>
      </div>
    </div>
  );
}

function ProgressBar({ value, max }: { value: number; max: number }) {
  const pct = Math.round((value / max) * 100);
  return (
    <div className="w-full bg-gray-100 rounded-full h-1.5">
      <div className="bg-gray-700 h-1.5 rounded-full" style={{ width: `${pct}%` }} />
    </div>
  );
}

// ─── Sidebar ───────────────────────────────────────────────────────────────
function Sidebar({
  role, page, onPage, collapsed, onCollapse, onRoleChange
}: {
  role: Role; page: AppPage; onPage: (p: AppPage) => void;
  collapsed: boolean; onCollapse: () => void; onRoleChange: (r: Role) => void;
}) {
  const items = NAV_CONFIG[role];
  const [showRoleMenu, setShowRoleMenu] = useState(false);

  return (
    <aside className={cn("flex flex-col h-screen border-r border-gray-200 bg-white transition-all duration-300 flex-shrink-0", collapsed ? "w-16" : "w-60")}>
      {/* Logo */}
      <div className="flex items-center gap-3 px-4 h-16 border-b border-gray-100">
        <div className="w-8 h-8 rounded-lg bg-gray-900 flex items-center justify-center flex-shrink-0">
          <GraduationCap size={16} className="text-white" />
        </div>
        {!collapsed && <div><p className="font-bold text-gray-900 text-sm leading-tight">UniDept</p><p className="text-xs text-gray-400">Management System</p></div>}
        <button onClick={onCollapse} className={cn("ml-auto w-7 h-7 rounded-md hover:bg-gray-100 flex items-center justify-center flex-shrink-0", collapsed && "mx-auto ml-0")}>
          {collapsed ? <ChevronRight size={14} className="text-gray-500" /> : <ChevronLeft size={14} className="text-gray-500" />}
        </button>
      </div>

      {/* Role Badge */}
      {!collapsed && (
        <div className="px-3 pt-3 pb-2">
          <button onClick={() => setShowRoleMenu(!showRoleMenu)}
            className="w-full flex items-center gap-2 px-3 py-2 rounded-lg bg-gray-50 border border-gray-200 hover:bg-gray-100 transition-colors">
            <Shield size={14} className="text-gray-500 flex-shrink-0" />
            <div className="flex-1 text-left min-w-0">
              <p className="text-[10px] text-gray-400 font-medium">CURRENT ROLE</p>
              <p className="text-xs font-semibold text-gray-800 truncate">{ROLE_LABELS[role]}</p>
            </div>
            <ChevronDown size={12} className="text-gray-400 flex-shrink-0" />
          </button>
          {showRoleMenu && (
            <div className="mt-1 bg-white border border-gray-200 rounded-lg shadow-lg py-1 z-20 relative">
              {(["hod", "coordinator", "faculty"] as Role[]).map(r => (
                <button key={r} onClick={() => { onRoleChange(r); setShowRoleMenu(false); }}
                  className={cn("w-full text-left px-3 py-2 text-xs hover:bg-gray-50", r === role ? "font-semibold text-gray-900" : "text-gray-600")}>
                  {ROLE_LABELS[r]}
                </button>
              ))}
            </div>
          )}
        </div>
      )}

      {/* Navigation */}
      <nav className="flex-1 overflow-y-auto px-2 py-2 space-y-0.5">
        {!collapsed && <p className="px-3 pt-2 pb-1 text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Main Navigation</p>}
        {items.map(({ id, label, icon: Icon }) => (
          <button key={id} onClick={() => onPage(id)}
            className={cn("w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors",
              page === id ? "bg-gray-900 text-white" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900",
              collapsed && "justify-center px-2")}>
            <Icon size={17} />
            {!collapsed && <span>{label}</span>}
          </button>
        ))}
      </nav>

      {/* Bottom Nav */}
      <div className="px-2 pb-4 pt-2 border-t border-gray-100 space-y-0.5">
        {BOTTOM_NAV.map(({ id, label, icon: Icon }) => (
          <button key={id} onClick={() => onPage(id)}
            className={cn("w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors relative",
              page === id ? "bg-gray-900 text-white" : "text-gray-500 hover:bg-gray-50 hover:text-gray-800",
              collapsed && "justify-center px-2")}>
            <Icon size={17} />
            {!collapsed && <span>{label}</span>}
            {id === "notifications" && !collapsed && (
              <span className="ml-auto bg-gray-800 text-white text-[10px] font-bold rounded-full px-1.5 py-0.5">3</span>
            )}
          </button>
        ))}
      </div>

      {/* User */}
      {!collapsed && (
        <div className="px-3 pb-3 border-t border-gray-100 pt-3">
          <div className="flex items-center gap-2">
            <Avatar name="Dr. Anita Sharma" size="sm" />
            <div className="flex-1 min-w-0">
              <p className="text-xs font-semibold text-gray-800 truncate">Dr. Anita Sharma</p>
              <p className="text-[10px] text-gray-400 truncate">anita.sharma@college.edu</p>
            </div>
            <LogOut size={13} className="text-gray-400 cursor-pointer hover:text-gray-700 flex-shrink-0" />
          </div>
        </div>
      )}
    </aside>
  );
}

// ─── TopNav ────────────────────────────────────────────────────────────────
function TopNav({
  role, page, onPage, onMenu
}: {
  role: Role; page: AppPage; onPage: (p: AppPage) => void; onMenu: () => void;
}) {
  const [search, setSearch] = useState("");
  const [showUser, setShowUser] = useState(false);
  const crumbs = BREADCRUMBS[page] ?? ["Home"];

  return (
    <header className="h-16 bg-white border-b border-gray-200 flex items-center gap-4 px-5 flex-shrink-0">
      <button onClick={onMenu} className="md:hidden w-9 h-9 rounded-lg hover:bg-gray-100 flex items-center justify-center">
        <Menu size={18} className="text-gray-600" />
      </button>

      {/* Breadcrumb */}
      <nav className="hidden md:flex items-center gap-1.5 text-sm min-w-0">
        {crumbs.map((c, i) => (
          <span key={i} className="flex items-center gap-1.5">
            {i > 0 && <ChevronRight size={13} className="text-gray-300 flex-shrink-0" />}
            <span className={cn("font-medium", i === crumbs.length - 1 ? "text-gray-900" : "text-gray-400 hover:text-gray-600 cursor-pointer")}>{c}</span>
          </span>
        ))}
      </nav>

      <div className="flex-1" />

      {/* Search */}
      <div className="hidden lg:flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-72">
        <Search size={14} className="text-gray-400 flex-shrink-0" />
        <input value={search} onChange={e => setSearch(e.target.value)} placeholder="Search anything..."
          className="flex-1 text-sm text-gray-700 placeholder-gray-400 bg-transparent outline-none" />
        <kbd className="text-[10px] text-gray-300 border border-gray-200 rounded px-1.5 py-0.5 font-mono">⌘K</kbd>
      </div>

      {/* AI Search */}
      <button className="hidden sm:flex items-center gap-2 bg-gray-900 text-white rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-700 transition-colors">
        <Sparkles size={14} />
        <span className="hidden xl:inline">AI Search</span>
      </button>

      {/* Notifications */}
      <button onClick={() => onPage("notifications")} className="relative w-9 h-9 rounded-lg hover:bg-gray-100 flex items-center justify-center">
        <Bell size={17} className="text-gray-600" />
        <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-gray-900 rounded-full" />
      </button>

      {/* User */}
      <div className="relative">
        <button onClick={() => setShowUser(!showUser)} className="flex items-center gap-2 hover:bg-gray-50 rounded-lg px-2 py-1.5">
          <Avatar name="Dr. Anita Sharma" size="sm" />
          <div className="hidden md:block text-left">
            <p className="text-xs font-semibold text-gray-800 leading-tight">Dr. Anita Sharma</p>
            <p className="text-[10px] text-gray-400 leading-tight">{ROLE_LABELS[role]}</p>
          </div>
          <ChevronDown size={13} className="text-gray-400" />
        </button>
        {showUser && (
          <div className="absolute right-0 top-full mt-2 w-52 bg-white border border-gray-200 rounded-xl shadow-xl py-2 z-30">
            <div className="px-3 py-2 border-b border-gray-100 mb-1">
              <p className="text-xs font-semibold text-gray-800">Dr. Anita Sharma</p>
              <p className="text-[10px] text-gray-400">anita.sharma@college.edu</p>
            </div>
            {[
              { label: "View Profile", icon: User, page: "profile" as AppPage },
              { label: "Settings", icon: Settings, page: "settings" as AppPage },
              { label: "Help & Support", icon: HelpCircle, page: "help" as AppPage },
            ].map(({ label, icon: Icon, page: pg }) => (
              <button key={label} onClick={() => { onPage(pg); setShowUser(false); }}
                className="w-full flex items-center gap-3 px-3 py-2 text-sm text-gray-600 hover:bg-gray-50">
                <Icon size={14} />
                {label}
              </button>
            ))}
            <div className="border-t border-gray-100 mt-1 pt-1">
              <button className="w-full flex items-center gap-3 px-3 py-2 text-sm text-gray-500 hover:bg-gray-50">
                <LogOut size={14} /><span>Sign Out</span>
              </button>
            </div>
          </div>
        )}
      </div>
    </header>
  );
}

// ─── AUTH PAGES ─────────────────────────────────────────────────────────────
function LoginPage({ onLogin, onForgot, onRoleChange, role }: {
  onLogin: () => void; onForgot: () => void; onRoleChange: (r: Role) => void; role: Role;
}) {
  const [email, setEmail] = useState("anita.sharma@college.edu");
  const [pw, setPw] = useState("••••••••");
  const [showPw, setShowPw] = useState(false);
  const [remember, setRemember] = useState(false);

  return (
    <div className="min-h-screen bg-gray-50 flex">
      {/* Left Panel */}
      <div className="hidden lg:flex flex-col justify-between w-2/5 bg-gray-900 p-12 text-white">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center">
            <GraduationCap size={20} className="text-white" />
          </div>
          <div>
            <p className="font-bold text-lg leading-tight">UniDept</p>
            <p className="text-xs text-white/50">Management System</p>
          </div>
        </div>
        <div>
          <h2 className="text-4xl font-bold leading-tight mb-4">Streamline your department management</h2>
          <p className="text-white/60 text-sm leading-relaxed">A unified platform for faculty, coordinators, and HODs to collaborate efficiently, manage tasks, documents, and meetings.</p>
          <div className="mt-8 grid grid-cols-2 gap-4">
            {[
              { label: "Departments", val: "8" }, { label: "Faculty", val: "47" },
              { label: "Active Tasks", val: "128" }, { label: "Meetings/mo", val: "24" }
            ].map(({ label, val }) => (
              <div key={label} className="bg-white/5 rounded-xl p-4 border border-white/10">
                <p className="text-2xl font-bold">{val}</p>
                <p className="text-xs text-white/50 mt-1">{label}</p>
              </div>
            ))}
          </div>
        </div>
        <p className="text-xs text-white/30">© 2026 UniDept College Management System. All rights reserved.</p>
      </div>

      {/* Right Panel */}
      <div className="flex-1 flex items-center justify-center p-8">
        <div className="w-full max-w-sm">
          <div className="mb-8">
            <div className="flex items-center gap-2 mb-6 lg:hidden">
              <div className="w-8 h-8 rounded-lg bg-gray-900 flex items-center justify-center">
                <GraduationCap size={16} className="text-white" />
              </div>
              <span className="font-bold text-gray-900">UniDept</span>
            </div>
            <h1 className="text-2xl font-bold text-gray-900 mb-1">Welcome back</h1>
            <p className="text-sm text-gray-500">Sign in to your account to continue</p>
          </div>

          {/* Role Switcher for Demo */}
          <div className="mb-6 p-3 bg-gray-50 border border-gray-200 rounded-xl">
            <p className="text-xs text-gray-500 mb-2 font-medium">DEMO — Select Role to Preview</p>
            <div className="flex gap-2">
              {(["hod", "coordinator", "faculty"] as Role[]).map(r => (
                <button key={r} onClick={() => onRoleChange(r)}
                  className={cn("flex-1 py-1.5 rounded-lg text-xs font-medium border transition-colors",
                    r === role ? "bg-gray-900 text-white border-gray-900" : "bg-white border-gray-200 text-gray-600 hover:border-gray-400")}>
                  {r === "hod" ? "HOD" : r === "coordinator" ? "Coord." : "Faculty"}
                </button>
              ))}
            </div>
          </div>

          <form onSubmit={e => { e.preventDefault(); onLogin(); }} className="space-y-4">
            <div>
              <label className="text-sm font-medium text-gray-700 block mb-1.5">Email address</label>
              <Input value={email} onChange={setEmail} placeholder="you@college.edu" icon={Mail} />
            </div>
            <div>
              <div className="flex items-center justify-between mb-1.5">
                <label className="text-sm font-medium text-gray-700">Password</label>
                <button type="button" onClick={onForgot} className="text-xs text-gray-500 hover:text-gray-800">Forgot password?</button>
              </div>
              <div className="relative">
                <Lock size={15} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
                <input type={showPw ? "text" : "password"} value={pw} onChange={e => setPw(e.target.value)}
                  className="w-full pl-9 pr-10 py-2 border border-gray-200 bg-gray-50 rounded-lg text-sm outline-none focus:ring-2 focus:ring-gray-300" />
                <button type="button" onClick={() => setShowPw(!showPw)} className="absolute right-3 top-1/2 -translate-y-1/2">
                  {showPw ? <EyeOff size={14} className="text-gray-400" /> : <Eye size={14} className="text-gray-400" />}
                </button>
              </div>
            </div>
            <div className="flex items-center gap-2">
              <input type="checkbox" id="remember" checked={remember} onChange={e => setRemember(e.target.checked)}
                className="w-4 h-4 rounded border-gray-300" />
              <label htmlFor="remember" className="text-sm text-gray-600">Remember me for 30 days</label>
            </div>
            <Btn variant="primary" size="lg" className="w-full justify-center">Sign In</Btn>
          </form>

          <p className="mt-6 text-center text-xs text-gray-400">Protected by enterprise SSO. Contact IT for access issues.</p>
        </div>
      </div>
    </div>
  );
}

function ForgotPasswordPage({ onBack }: { onBack: () => void }) {
  const [email, setEmail] = useState("");
  const [sent, setSent] = useState(false);
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center p-8">
      <div className="w-full max-w-sm">
        <button onClick={onBack} className="flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 mb-8">
          <ChevronLeft size={16} /> Back to sign in
        </button>
        <div className="w-14 h-14 rounded-2xl bg-gray-100 flex items-center justify-center mb-6">
          <Key size={24} className="text-gray-600" />
        </div>
        <h1 className="text-2xl font-bold text-gray-900 mb-1">Forgot password?</h1>
        <p className="text-sm text-gray-500 mb-6">Enter your email address and we'll send you a reset link.</p>
        {sent ? (
          <div className="bg-gray-50 border border-gray-200 rounded-xl p-5 text-center">
            <CheckCircle size={32} className="text-gray-700 mx-auto mb-3" />
            <p className="font-semibold text-gray-900 mb-1">Reset link sent!</p>
            <p className="text-sm text-gray-500">Check your email inbox and follow the instructions.</p>
          </div>
        ) : (
          <form onSubmit={e => { e.preventDefault(); setSent(true); }} className="space-y-4">
            <Input value={email} onChange={setEmail} placeholder="you@college.edu" icon={Mail} />
            <Btn variant="primary" size="lg" className="w-full justify-center">Send Reset Link</Btn>
          </form>
        )}
      </div>
    </div>
  );
}

function ResetPasswordPage({ onBack }: { onBack: () => void }) {
  const [pw, setPw] = useState("");
  const [confirm, setConfirm] = useState("");
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center p-8">
      <div className="w-full max-w-sm">
        <div className="w-14 h-14 rounded-2xl bg-gray-100 flex items-center justify-center mb-6">
          <Lock size={24} className="text-gray-600" />
        </div>
        <h1 className="text-2xl font-bold text-gray-900 mb-1">Set new password</h1>
        <p className="text-sm text-gray-500 mb-6">Must be at least 8 characters with uppercase, number, and symbol.</p>
        <form onSubmit={e => { e.preventDefault(); onBack(); }} className="space-y-4">
          <div>
            <label className="text-sm font-medium text-gray-700 block mb-1.5">New Password</label>
            <Input value={pw} onChange={setPw} type="password" placeholder="Enter new password" icon={Lock} />
          </div>
          <div>
            <label className="text-sm font-medium text-gray-700 block mb-1.5">Confirm Password</label>
            <Input value={confirm} onChange={setConfirm} type="password" placeholder="Confirm new password" icon={Lock} />
          </div>
          <div className="space-y-1.5">
            {["At least 8 characters", "One uppercase letter", "One number", "One special character"].map(rule => (
              <div key={rule} className="flex items-center gap-2 text-xs text-gray-500">
                <div className={cn("w-4 h-4 rounded-full flex items-center justify-center", pw.length >= 8 ? "bg-gray-800" : "bg-gray-200")}>
                  <CheckCircle size={10} className={pw.length >= 8 ? "text-white" : "text-gray-400"} />
                </div>
                {rule}
              </div>
            ))}
          </div>
          <Btn variant="primary" size="lg" className="w-full justify-center">Update Password</Btn>
        </form>
      </div>
    </div>
  );
}

// ─── HOD Dashboard ─────────────────────────────────────────────────────────
function HODDashboard({ onPage }: { onPage: (p: AppPage) => void }) {
  return (
    <div className="p-6 space-y-6">
      {/* Welcome */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Good morning, Dr. Sharma</h1>
          <p className="text-sm text-gray-500 mt-0.5">Monday, 30 June 2026 · Computer Science Department</p>
        </div>
        <div className="flex gap-3">
          <Btn variant="outline" size="sm" icon={RefreshCw}>Refresh</Btn>
          <Btn variant="primary" size="sm" icon={Plus}>Quick Action</Btn>
        </div>
      </div>

      {/* Summary Cards */}
      <div className="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-4">
        <StatCard label="Total Faculty" value={47} sub="Across 8 depts" icon={Users} />
        <StatCard label="Departments" value={8} sub="Active this sem" icon={Building2} />
        <StatCard label="Active Tasks" value={23} sub="5 high priority" icon={CheckSquare} />
        <StatCard label="Pending Approvals" value={5} sub="Needs review" icon={AlertCircle} />
        <StatCard label="Meetings Today" value={3} sub="Next: 10:00 AM" icon={Video} />
        <StatCard label="Documents" value={142} sub="12 new this week" icon={FileText} />
        <StatCard label="Announcements" value={12} sub="3 pinned" icon={Megaphone} />
      </div>

      {/* Charts Row */}
      <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4">
        <ChartCard title="Faculty Workload (hrs/week)">
          <ResponsiveContainer width="100%" height={140}>
            <RBar data={workloadData} barSize={20}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={24} />
              <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8, border: "1px solid #E4E4E7" }} />
              <Bar dataKey="hours" fill="#27272A" radius={[4, 4, 0, 0]} />
            </RBar>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Task Completion Trend">
          <ResponsiveContainer width="100%" height={140}>
            <RLine data={taskCompletionData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={24} />
              <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8, border: "1px solid #E4E4E7" }} />
              <Line type="monotone" dataKey="completed" stroke="#27272A" strokeWidth={2} dot={{ r: 3, fill: "#27272A" }} />
              <Line type="monotone" dataKey="pending" stroke="#A1A1AA" strokeWidth={2} strokeDasharray="4 4" dot={{ r: 3, fill: "#A1A1AA" }} />
            </RLine>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Document Upload Trends">
          <ResponsiveContainer width="100%" height={140}>
            <RArea data={uploadTrendData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={24} />
              <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8, border: "1px solid #E4E4E7" }} />
              <Area type="monotone" dataKey="docs" stroke="#52525B" fill="#F4F4F5" strokeWidth={2} />
            </RArea>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Dept. Distribution">
          <ResponsiveContainer width="100%" height={140}>
            <RPie>
              <Pie data={deptDistData} cx="50%" cy="50%" innerRadius={35} outerRadius={60} dataKey="value" paddingAngle={2}>
                {deptDistData.map((_, i) => <Cell key={i} fill={CHART_COLORS[i % CHART_COLORS.length]} />)}
              </Pie>
              <Tooltip contentStyle={{ fontSize: 10, borderRadius: 8, border: "1px solid #E4E4E7" }} />
            </RPie>
          </ResponsiveContainer>
        </ChartCard>
      </div>

      {/* Widgets */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Recent Announcements */}
        <Card className="p-5">
          <SectionHeader title="Recent Announcements" action={
            <Btn variant="ghost" size="sm" onClick={() => onPage("announcements")}>View all <ArrowRight size={12} /></Btn>
          } />
          <div className="space-y-3">
            {ANNOUNCEMENTS_DATA.slice(0, 3).map(a => (
              <div key={a.id} className="flex gap-3 pb-3 border-b border-gray-50 last:border-0 last:pb-0">
                <div className="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Megaphone size={14} className="text-gray-500" />
                </div>
                <div className="min-w-0">
                  <div className="flex items-center gap-2 mb-0.5">
                    <p className="text-xs font-semibold text-gray-800 truncate">{a.title}</p>
                    {a.pinned && <Pin size={10} className="text-gray-400 flex-shrink-0" />}
                  </div>
                  <p className="text-xs text-gray-400">{a.category} · {a.date}</p>
                </div>
              </div>
            ))}
          </div>
        </Card>

        {/* Upcoming Meetings */}
        <Card className="p-5">
          <SectionHeader title="Upcoming Meetings" action={
            <Btn variant="ghost" size="sm" onClick={() => onPage("meetings")}>View all <ArrowRight size={12} /></Btn>
          } />
          <div className="space-y-3">
            {MEETINGS_DATA.filter(m => m.status === "Upcoming").map(m => (
              <div key={m.id} className="flex gap-3 pb-3 border-b border-gray-50 last:border-0 last:pb-0">
                <div className="w-10 h-10 rounded-lg bg-gray-50 border border-gray-200 flex flex-col items-center justify-center flex-shrink-0 text-center">
                  <p className="text-[10px] text-gray-400 font-medium">{m.date.slice(5, 7)}/{m.date.slice(8)}</p>
                  <p className="text-[10px] text-gray-600">{m.time.split(":")[0]}{m.time.includes("PM") ? "pm" : "am"}</p>
                </div>
                <div className="min-w-0">
                  <p className="text-xs font-semibold text-gray-800 leading-tight mb-0.5 line-clamp-1">{m.title}</p>
                  <p className="text-xs text-gray-400">{m.participants} participants · {m.location}</p>
                </div>
              </div>
            ))}
          </div>
        </Card>

        {/* Pending Approvals & AI Insights */}
        <div className="space-y-4">
          <Card className="p-5">
            <SectionHeader title="Pending Approvals" />
            <div className="space-y-2">
              {[
                { label: "Faculty Leave Request", type: "Leave", sub: "Vikram Singh · Jun 30" },
                { label: "Document Upload Review", type: "Document", sub: "NAAC Report · Needs HOD sign" },
                { label: "Task Reassignment", type: "Task", sub: "Lab Inventory · Unassigned" },
              ].map((item, i) => (
                <div key={i} className="flex items-center gap-3 p-2.5 rounded-lg bg-gray-50 border border-gray-100">
                  <div className="flex-1 min-w-0">
                    <p className="text-xs font-medium text-gray-800 truncate">{item.label}</p>
                    <p className="text-[10px] text-gray-400">{item.sub}</p>
                  </div>
                  <div className="flex gap-1">
                    <button className="w-6 h-6 rounded-md bg-gray-200 hover:bg-gray-300 flex items-center justify-center"><CheckCircle size={11} className="text-gray-600" /></button>
                    <button className="w-6 h-6 rounded-md bg-gray-100 hover:bg-gray-200 flex items-center justify-center"><X size={11} className="text-gray-400" /></button>
                  </div>
                </div>
              ))}
            </div>
          </Card>

          <Card className="p-5 border-2 border-dashed border-gray-200">
            <div className="flex items-center gap-2 mb-3">
              <Sparkles size={14} className="text-gray-500" />
              <p className="text-sm font-semibold text-gray-800">AI Insights</p>
            </div>
            <div className="space-y-2">
              {[
                "3 faculty members have workload above 120%",
                "Task completion rate improved 12% vs. last month",
                "2 upcoming deadlines in the next 48 hours",
              ].map((insight, i) => (
                <p key={i} className="text-xs text-gray-600 flex gap-2"><span className="text-gray-300">›</span>{insight}</p>
              ))}
            </div>
          </Card>
        </div>
      </div>

      {/* Department Activity */}
      <Card className="p-5">
        <SectionHeader title="Department Activity Feed" subtitle="Recent actions across all departments" action={
          <Btn variant="ghost" size="sm">View all activity</Btn>
        } />
        <div className="space-y-3">
          {[
            { who: "Prof. Rajan Mehta", action: "uploaded", what: "Faculty Workload Distribution — Semester II", time: "2h ago", icon: Upload },
            { who: "Dr. Priya Nair", action: "completed task", what: "Faculty Feedback Analysis — Semester I", time: "4h ago", icon: CheckSquare },
            { who: "Admin Office", action: "posted announcement", what: "New Faculty Onboarding — Orientation Program", time: "6h ago", icon: Megaphone },
            { who: "Dr. Anita Sharma", action: "scheduled meeting", what: "Department Faculty Meeting — July Curriculum", time: "1d ago", icon: Video },
            { who: "Quality Cell", action: "uploaded", what: "NAAC Accreditation Report — Self Study Document", time: "1d ago", icon: FileUp },
          ].map((item, i) => (
            <div key={i} className="flex items-center gap-3 py-2 border-b border-gray-50 last:border-0">
              <Avatar name={item.who} size="sm" />
              <div className="flex-1 min-w-0">
                <p className="text-xs text-gray-700"><span className="font-semibold">{item.who}</span> {item.action} <span className="text-gray-500">{item.what}</span></p>
              </div>
              <p className="text-[10px] text-gray-400 flex-shrink-0">{item.time}</p>
            </div>
          ))}
        </div>
      </Card>
    </div>
  );
}

// ─── Coordinator Dashboard ─────────────────────────────────────────────────
