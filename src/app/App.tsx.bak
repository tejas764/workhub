    <div className="p-6 space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Good morning, Prof. Mehta</h1>
          <p className="text-sm text-gray-500 mt-0.5">Monday, 30 June 2026 · Department Coordinator</p>
        </div>
        <div className="flex gap-3">
          <Btn variant="outline" size="sm" icon={Plus} onClick={() => onPage("announcements")}>New Announcement</Btn>
          <Btn variant="primary" size="sm" icon={Video} onClick={() => onPage("meetings")}>Schedule Meeting</Btn>
        </div>
      </div>

      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <StatCard label="Assigned Tasks" value={18} sub="4 overdue" icon={CheckSquare} />
        <StatCard label="My Meetings" value={5} sub="2 this week" icon={Video} />
        <StatCard label="My Documents" value={34} sub="3 new uploads" icon={FileText} />
        <StatCard label="Announcements" value={8} sub="2 from me" icon={Megaphone} />
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Today's Schedule */}
        <Card className="p-5 lg:col-span-1">
          <SectionHeader title="Today's Schedule" subtitle="Monday, June 30" />
          <div className="space-y-3">
            {[
              { time: "09:00", title: "Faculty Sync — Quick Standup", type: "meeting", done: true },
              { time: "10:30", title: "Review NAAC Document Submissions", type: "task", done: false },
              { time: "02:00", title: "Research Committee Meeting", type: "meeting", done: false },
              { time: "04:00", title: "Submit Q2 Performance Reports", type: "task", done: false },
            ].map((item, i) => (
              <div key={i} className={cn("flex gap-3 items-start pb-3 border-b border-gray-50 last:border-0 last:pb-0", item.done && "opacity-50")}>
                <div className="w-14 text-xs font-mono text-gray-400 pt-0.5 flex-shrink-0">{item.time}</div>
                <div className={cn("w-2 h-2 rounded-full mt-1.5 flex-shrink-0", item.type === "meeting" ? "bg-gray-700" : "bg-gray-400")} />
                <p className={cn("text-xs font-medium text-gray-700", item.done && "line-through")}>{item.title}</p>
              </div>
            ))}
