            <SectionHeader title="Upcoming Meetings" action={
              <Btn variant="ghost" size="sm" onClick={() => onPage("meetings")}>All <ArrowRight size={12} /></Btn>
            } />
            <div className="space-y-3">
              {MEETINGS_DATA.filter(m => m.status === "Upcoming").slice(0, 3).map(m => (
                <div key={m.id} className="flex gap-3 items-center pb-2.5 border-b border-gray-50 last:border-0">
                  <div className="w-10 h-10 rounded-lg bg-gray-100 flex flex-col items-center justify-center text-center flex-shrink-0">
                    <p className="text-[10px] font-bold text-gray-700">{m.date.slice(8)}</p>
                    <p className="text-[9px] text-gray-400">{["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][parseInt(m.date.slice(5,7))-1]}</p>
                  </div>
                  <div className="min-w-0">
                    <p className="text-xs font-medium text-gray-800 line-clamp-1">{m.title}</p>
                    <p className="text-[10px] text-gray-400">{m.time} · {m.location}</p>
                  </div>
                </div>
              ))}
            </div>
          </Card>

          <Card className="p-5">
            <SectionHeader title="Recent Notices" action={
              <Btn variant="ghost" size="sm" onClick={() => onPage("announcements")}>All <ArrowRight size={12} /></Btn>
            } />
            <div className="space-y-2">
              {ANNOUNCEMENTS_DATA.slice(0, 3).map(a => (
                <div key={a.id} className="py-2 border-b border-gray-50 last:border-0">
                  <div className="flex items-start gap-1.5">
                    {a.pinned && <Pin size={10} className="text-gray-400 mt-0.5 flex-shrink-0" />}
                    <p className="text-xs font-medium text-gray-800 line-clamp-1">{a.title}</p>
                  </div>
                  <p className="text-[10px] text-gray-400 mt-0.5">{a.date} · {a.category}</p>
                </div>
              ))}
            </div>
          </Card>
        </div>
      </div>
    </div>
  );
}

// ─── Faculty Management Page ───────────────────────────────────────────────
function FacultyPage({ role }: { role: Role }) {
  const [search, setSearch] = useState("");
  const [deptFilter, setDeptFilter] = useState("All Departments");
  const [roleFilter, setRoleFilter] = useState("All Roles");
  const [statusFilter, setStatusFilter] = useState("All Status");
  const [selected, setSelected] = useState<FacultyMember | null>(null);
  const [activeTab, setActiveTab] = useState("Basic Info");
  const [page, setPage] = useState(1);

  const filtered = FACULTY_DATA.filter(f => {
    const q = search.toLowerCase();
    return (
      (f.name.toLowerCase().includes(q) || f.email.toLowerCase().includes(q) || f.designation.toLowerCase().includes(q)) &&
      (deptFilter === "All Departments" || f.department === deptFilter) &&
      (roleFilter === "All Roles" || f.role === roleFilter) &&
      (statusFilter === "All Status" || f.status === statusFilter)
    );
  });

  const isHOD = role === "hod";

  return (
    <div className="p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">{isHOD ? "Faculty Management" : "Faculty Directory"}</h1>
          <p className="text-sm text-gray-500 mt-0.5">{FACULTY_DATA.length} faculty members across 8 departments</p>
        </div>
        <div className="flex gap-3">
          <Btn variant="outline" size="sm" icon={Download}>Export</Btn>
          {isHOD && <Btn variant="primary" size="sm" icon={Plus}>Add Faculty</Btn>}
        </div>
      </div>

      <FilterBar>
        <Input placeholder="Search by name, email, or designation..." value={search} onChange={setSearch} icon={Search} className="flex-1 min-w-48" />
        <Select options={["All Departments", "Computer Science", "Electronics", "Mathematics", "Physics", "Civil", "Mechanical"]}
          value={deptFilter} onChange={setDeptFilter} />
        <Select options={["All Roles", "HOD", "Coordinator", "Faculty"]} value={roleFilter} onChange={setRoleFilter} />
        <Select options={["All Status", "Active", "On Leave", "Inactive"]} value={statusFilter} onChange={setStatusFilter} />
        <Btn variant="ghost" size="sm" icon={SlidersHorizontal}>Filters</Btn>
        <Btn variant="ghost" size="sm" icon={SortAsc}>Sort</Btn>
      </FilterBar>

      <Card className="overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="bg-gray-50 border-b border-gray-200">
                {["Faculty", "Email", "Designation", "Department", "Role", "Status", "Actions"].map(h => (
                  <th key={h} className="px-4 py-3 text-left text-xs font-semibold text-gray-500 whitespace-nowrap">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-100">
              {filtered.slice((page - 1) * 5, page * 5).map(f => (
                <tr key={f.id} className="hover:bg-gray-50 transition-colors cursor-pointer" onClick={() => setSelected(f)}>
                  <td className="px-4 py-3">
                    <div className="flex items-center gap-3">
                      <Avatar name={f.name} size="sm" />
                      <span className="text-sm font-medium text-gray-900">{f.name}</span>
                    </div>
                  </td>
                  <td className="px-4 py-3 text-sm text-gray-600">{f.email}</td>
                  <td className="px-4 py-3 text-sm text-gray-600">{f.designation}</td>
                  <td className="px-4 py-3 text-sm text-gray-600">{f.department}</td>
                  <td className="px-4 py-3"><CategoryBadge label={f.role} /></td>
                  <td className="px-4 py-3"><StatusBadge status={f.status} /></td>
                  <td className="px-4 py-3">
                    <div className="flex gap-1">
                      <button className="p-1.5 hover:bg-gray-100 rounded-md" onClick={e => { e.stopPropagation(); setSelected(f); }}>
                        <Eye size={14} className="text-gray-500" />
                      </button>
                      {isHOD && <>
                        <button className="p-1.5 hover:bg-gray-100 rounded-md" onClick={e => e.stopPropagation()}>
                          <Pencil size={14} className="text-gray-500" />
                        </button>
                        <button className="p-1.5 hover:bg-gray-100 rounded-md" onClick={e => e.stopPropagation()}>
                          <MoreHorizontal size={14} className="text-gray-500" />
                        </button>
                      </>}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div className="px-4">
          <Pagination current={page} total={filtered.length} onChange={setPage} />
        </div>
      </Card>

      {/* Faculty Detail Drawer */}
      {selected && (
        <Drawer title={selected.name} onClose={() => setSelected(null)} width="w-[520px]">
          <div className="flex items-center gap-4 pb-5 mb-5 border-b border-gray-100">
            <Avatar name={selected.name} size="xl" />
            <div>
              <h3 className="text-lg font-bold text-gray-900">{selected.name}</h3>
              <p className="text-sm text-gray-500">{selected.designation}</p>
              <div className="flex gap-2 mt-2">
                <StatusBadge status={selected.status} />
                <CategoryBadge label={selected.role} />
              </div>
            </div>
            {isHOD && <div className="ml-auto flex gap-2">
              <Btn variant="outline" size="sm" icon={Pencil}>Edit</Btn>
              <Btn variant="ghost" size="sm"><MoreHorizontal size={14} /></Btn>
            </div>}
          </div>
          <Tabs tabs={["Basic Info", "Contact", "Department", "Tasks", "Documents", "Timeline"]} active={activeTab} onChange={setActiveTab} />
          {activeTab === "Basic Info" && (
            <div className="space-y-3">
              {[
                { label: "Full Name", val: selected.name },
                { label: "Designation", val: selected.designation },
                { label: "Employee ID", val: `EMP-${String(selected.id).padStart(4, "0")}` },
                { label: "Date of Joining", val: selected.joined },
                { label: "Department", val: selected.department },
                { label: "Role", val: selected.role },
              ].map(({ label, val }) => (
                <div key={label} className="flex justify-between py-2 border-b border-gray-50">
                  <span className="text-sm text-gray-500">{label}</span>
                  <span className="text-sm font-medium text-gray-900">{val}</span>
                </div>
              ))}
            </div>
          )}
          {activeTab === "Contact" && (
            <div className="space-y-3">
              {[
                { icon: Mail, label: "Email", val: selected.email },
                { icon: Phone, label: "Phone", val: selected.phone },
                { icon: MapPin, label: "Office", val: "Room 204, Dept. Block A" },
              ].map(({ icon: Icon, label, val }) => (
                <div key={label} className="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
                  <Icon size={16} className="text-gray-500" />
                  <div>
                    <p className="text-xs text-gray-400">{label}</p>
                    <p className="text-sm font-medium text-gray-800">{val}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
          {activeTab === "Tasks" && (
            <div className="space-y-2">
              {TASKS_DATA.filter(t => t.assignee.includes(selected.name.split(" ").pop()!)).map(t => (
                <div key={t.id} className="p-3 rounded-xl border border-gray-100">
                  <div className="flex items-start justify-between gap-2 mb-1.5">
                    <p className="text-sm font-medium text-gray-800">{t.title}</p>
                    <PriorityBadge priority={t.priority} />
                  </div>
                  <div className="flex gap-3">
                    <StatusBadge status={t.status} />
                    <p className="text-xs text-gray-400">Due {t.dueDate}</p>
                  </div>
                </div>
              ))}
              {TASKS_DATA.filter(t => t.assignee.includes(selected.name.split(" ").pop()!)).length === 0 && (
                <EmptyState icon={CheckSquare} title="No tasks" description="No tasks assigned to this faculty member." />
              )}
            </div>
          )}
          {(activeTab === "Department" || activeTab === "Documents" || activeTab === "Timeline") && (
            <EmptyState icon={Layers} title={`${activeTab} details`} description="This section will show detailed information." />
          )}
        </Drawer>
      )}
    </div>
  );
}

// ─── Announcements Page ────────────────────────────────────────────────────
function AnnouncementsPage({ role }: { role: Role }) {
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All Categories");
  const [view, setView] = useState<"grid" | "list">("grid");
  const [selected, setSelected] = useState<Announcement | null>(null);

  const canCreate = role !== "faculty";

  return (
    <div className="p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Announcements</h1>
          <p className="text-sm text-gray-500 mt-0.5">Department-wide notices and updates</p>
        </div>
        {canCreate && <Btn variant="primary" size="sm" icon={Plus}>Create Announcement</Btn>}
      </div>

      <FilterBar>
        <Input placeholder="Search announcements..." value={search} onChange={setSearch} icon={Search} className="flex-1 min-w-48" />
        <Select options={["All Categories", "Academic", "Examination", "HR", "Research", "Facilities"]}
          value={category} onChange={setCategory} />
        <Input placeholder="Date range..." icon={Calendar} className="w-44" />
        <div className="ml-auto flex border border-gray-200 rounded-lg overflow-hidden">
          <button onClick={() => setView("grid")} className={cn("px-3 py-2 text-xs", view === "grid" ? "bg-gray-900 text-white" : "bg-white text-gray-500 hover:bg-gray-50")}>
            <LayoutGrid size={14} />
          </button>
          <button onClick={() => setView("list")} className={cn("px-3 py-2 text-xs", view === "list" ? "bg-gray-900 text-white" : "bg-white text-gray-500 hover:bg-gray-50")}>
            <List size={14} />
          </button>
        </div>
      </FilterBar>

      <div className={cn(view === "grid" ? "grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" : "space-y-3")}>
        {ANNOUNCEMENTS_DATA.map(a => (
          <Card key={a.id} className="p-5 hover:shadow-md transition-shadow" onClick={() => setSelected(a)}>
            <div className="flex items-start justify-between gap-2 mb-3">
              <div className="flex items-center gap-2 flex-wrap">
                <CategoryBadge label={a.category} />
                {a.pinned && (
                  <span className="flex items-center gap-1 text-[10px] font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
                    <Pin size={9} /> Pinned
                  </span>
                )}
              </div>
              {canCreate && <button className="text-gray-400 hover:text-gray-700" onClick={e => e.stopPropagation()}>
                <MoreHorizontal size={15} />
              </button>}
            </div>
            <h3 className="text-sm font-semibold text-gray-900 leading-snug mb-2 line-clamp-2">{a.title}</h3>

            {/* AI Summary */}
            <div className="mb-3 p-2.5 bg-gray-50 rounded-lg border border-gray-100">
              <div className="flex items-center gap-1 mb-1">
                <Sparkles size={10} className="text-gray-400" />
                <span className="text-[10px] font-medium text-gray-400 uppercase tracking-wide">AI Summary</span>
              </div>
              <p className="text-xs text-gray-600 line-clamp-2">{a.summary}</p>
            </div>

            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Avatar name={a.postedBy} size="sm" />
                <div>
                  <p className="text-xs font-medium text-gray-700">{a.postedBy}</p>
                  <p className="text-[10px] text-gray-400">{a.department} · {a.date}</p>
                </div>
              </div>
              {a.hasAttachment && <Paperclip size={13} className="text-gray-400" />}
            </div>
          </Card>
        ))}
      </div>

      {/* Detail Modal */}
      {selected && (
        <Modal title={selected.title} onClose={() => setSelected(null)}
          footer={<><Btn variant="outline" onClick={() => setSelected(null)}>Close</Btn>{canCreate && <Btn variant="primary" icon={Pencil}>Edit</Btn>}</>}>
          <div className="space-y-4">
            <div className="flex flex-wrap gap-2">
              <CategoryBadge label={selected.category} />
              <CategoryBadge label={selected.department} />
              {selected.pinned && <CategoryBadge label="📌 Pinned" />}
            </div>
            <div className="flex items-center gap-3 pb-3 border-b border-gray-100">
              <Avatar name={selected.postedBy} size="sm" />
              <div>
                <p className="text-sm font-semibold text-gray-800">{selected.postedBy}</p>
                <p className="text-xs text-gray-400">{selected.date}</p>
              </div>
            </div>
            <div className="p-3 bg-gray-50 rounded-xl border border-gray-100">
              <div className="flex items-center gap-1.5 mb-2">
                <Sparkles size={12} className="text-gray-500" />
                <span className="text-xs font-semibold text-gray-600">AI Summary</span>
              </div>
              <p className="text-sm text-gray-600">{selected.summary}</p>
            </div>
            <div>
              <p className="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Full Content</p>
              <div className="bg-gray-50 rounded-xl p-4 min-h-24 text-sm text-gray-700 leading-relaxed">
                This is the full announcement content. The Head of Department calls attention to the matter described in this announcement. All relevant faculty are expected to take note and comply accordingly. Further details are available upon request.
              </div>
            </div>
            {selected.hasAttachment && (
              <div className="flex items-center gap-3 p-3 bg-gray-50 rounded-xl border border-gray-100">
                <FileIcon type="pdf" />
                <div className="flex-1">
                  <p className="text-xs font-medium text-gray-800">Attached Document.pdf</p>
                  <p className="text-[10px] text-gray-400">2.4 MB · Click to preview</p>
                </div>
                <Btn variant="ghost" size="sm" icon={Download}>Download</Btn>
              </div>
            )}
          </div>
        </Modal>
      )}
    </div>
  );
}

// ─── Meetings Page ─────────────────────────────────────────────────────────
function MeetingsPage({ role }: { role: Role }) {
  const [tab, setTab] = useState("Upcoming");
  const [selected, setSelected] = useState<Meeting | null>(null);
  const [detailTab, setDetailTab] = useState("Agenda");
  const canCreate = role !== "faculty";

  const filtered = MEETINGS_DATA.filter(m => m.status === tab || (tab === "All" && true));

  return (
    <div className="p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Meetings</h1>
          <p className="text-sm text-gray-500 mt-0.5">Schedule and manage department meetings</p>
        </div>
        <div className="flex gap-3">
          <Btn variant="outline" size="sm" icon={Calendar}>Calendar View</Btn>
          {canCreate && <Btn variant="primary" size="sm" icon={Plus}>Schedule Meeting</Btn>}
        </div>
      </div>

      <FilterBar>
        <Input placeholder="Search meetings..." icon={Search} className="flex-1 min-w-40" />
        <Select options={["All Departments", "Computer Science", "Electronics"]} />
        <Input placeholder="Date..." icon={Calendar} className="w-40" />
        <Select options={["All Status", "Upcoming", "Completed", "Cancelled"]} />
      </FilterBar>

      <Tabs tabs={["Upcoming", "Completed", "Cancelled"]} active={tab} onChange={setTab} />

      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {MEETINGS_DATA.filter(m => m.status === tab).map(m => (
          <Card key={m.id} className="p-5" onClick={() => { setSelected(m); setDetailTab("Agenda"); }}>
            <div className="flex items-start justify-between gap-2 mb-3">
              <StatusBadge status={m.status} />
              {canCreate && <button onClick={e => e.stopPropagation()} className="text-gray-400 hover:text-gray-600">
                <MoreHorizontal size={15} />
              </button>}
            </div>
            <h3 className="text-sm font-semibold text-gray-900 mb-3 leading-snug">{m.title}</h3>
            <div className="space-y-2 text-xs text-gray-500">
              <div className="flex items-center gap-2"><Calendar size={12} /> {m.date} · {m.time}</div>
              <div className="flex items-center gap-2"><MapPin size={12} /> {m.location}</div>
              <div className="flex items-center gap-2"><Users size={12} /> {m.participants} participants</div>
            </div>
            <div className="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Avatar name={m.organizer} size="sm" />
                <p className="text-xs text-gray-500">{m.organizer}</p>
              </div>
              {m.status === "Upcoming" && canCreate && (
                <Btn variant="outline" size="sm">Manage</Btn>
              )}
            </div>
          </Card>
        ))}
        {MEETINGS_DATA.filter(m => m.status === tab).length === 0 && (
          <div className="col-span-3">
            <EmptyState icon={Video} title={`No ${tab} meetings`} description={`There are no ${tab.toLowerCase()} meetings at this time.`}
              action={canCreate ? <Btn variant="primary" size="sm" icon={Plus}>Schedule Meeting</Btn> : undefined} />
          </div>
        )}
      </div>

      {/* Meeting Detail Drawer */}
      {selected && (
        <Drawer title="Meeting Details" onClose={() => setSelected(null)} width="w-[580px]">
          <div className="pb-4 mb-4 border-b border-gray-100">
            <div className="flex items-start justify-between gap-2 mb-2">
              <h3 className="text-base font-bold text-gray-900">{selected.title}</h3>
              <StatusBadge status={selected.status} />
            </div>
            <div className="grid grid-cols-2 gap-2 mt-3">
              {[
                { icon: Calendar, val: `${selected.date} · ${selected.time}` },
                { icon: MapPin, val: selected.location },
                { icon: Users, val: `${selected.participants} participants` },
                { icon: User, val: `Organized by ${selected.organizer}` },
              ].map(({ icon: Icon, val }) => (
                <div key={val} className="flex items-center gap-2 text-xs text-gray-500">
                  <Icon size={12} className="flex-shrink-0" />{val}
                </div>
              ))}
            </div>
          </div>
          <Tabs tabs={["Agenda", "Minutes", "Decisions", "Attendance", "Action Items", "Attachments"]} active={detailTab} onChange={setDetailTab} />
          {detailTab === "Agenda" && (
            <div className="space-y-3">
              {["Opening & Roll Call", "Review of Previous Minutes", "Curriculum Updates Discussion", "Faculty Performance Metrics", "Budget Utilization Report", "Any Other Business"].map((item, i) => (
                <div key={i} className="flex gap-3 p-3 rounded-xl bg-gray-50 border border-gray-100">
                  <span className="w-6 h-6 rounded-full bg-gray-200 text-xs font-bold text-gray-600 flex items-center justify-center flex-shrink-0">{i + 1}</span>
                  <p className="text-sm text-gray-700">{item}</p>
                  <p className="ml-auto text-xs text-gray-400 flex-shrink-0">{10 + i * 5} min</p>
                </div>
              ))}
            </div>
          )}
          {detailTab === "Attendance" && (
            <div className="space-y-2">
              {FACULTY_DATA.slice(0, 5).map(f => (
                <div key={f.id} className="flex items-center gap-3 p-2.5 rounded-xl border border-gray-100">
                  <Avatar name={f.name} size="sm" />
                  <div className="flex-1">
                    <p className="text-xs font-semibold text-gray-800">{f.name}</p>
                    <p className="text-[10px] text-gray-400">{f.designation}</p>
                  </div>
                  <div className="flex items-center gap-1.5 text-xs text-gray-600">
                    <CheckCircle size={13} className="text-gray-700" /> Present
                  </div>
                </div>
              ))}
            </div>
          )}
          {["Minutes", "Decisions", "Action Items", "Attachments"].includes(detailTab) && (
            <EmptyState icon={FileText} title={`No ${detailTab}`} description={`${detailTab} will appear here after the meeting.`} />
          )}
          {selected.status === "Upcoming" && canCreate && (
            <div className="mt-5 flex gap-3">
              <Btn variant="primary" className="flex-1 justify-center">Start Meeting</Btn>
              <Btn variant="outline" className="flex-1 justify-center">Edit Details</Btn>
            </div>
          )}
        </Drawer>
      )}
    </div>
  );
}

// ─── Documents Page ─────────────────────────────────────────────────────────
function DocumentsPage({ role }: { role: Role }) {
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All Categories");
  const [view, setView] = useState<"grid" | "list">("grid");
  const [selected, setSelected] = useState<DocItem | null>(null);
  const [aiChat, setAiChat] = useState("");
  const [chatMsgs, setChatMsgs] = useState<{ from: "user" | "ai"; text: string }[]>([]);

  return (
    <div className="p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Documents</h1>
          <p className="text-sm text-gray-500 mt-0.5">Department document repository</p>
        </div>
        <div className="flex gap-3">
          <Btn variant="outline" size="sm" icon={FolderOpen}>Browse Folders</Btn>
          <Btn variant="primary" size="sm" icon={Upload}>Upload Document</Btn>
        </div>
      </div>

      <FilterBar>
        <Input placeholder="Search documents..." value={search} onChange={setSearch} icon={Search} className="flex-1 min-w-40" />
        <Select options={["All Categories", "Academic", "Administrative", "Accreditation", "Research", "Finance", "HR", "Facilities"]}
          value={category} onChange={setCategory} />
        <Select options={["All Types", "PDF", "Word", "Excel", "PowerPoint", "Image"]} />
        <Select options={["Date: Newest First", "Date: Oldest First", "Name A–Z", "Size: Largest"]} />
        <div className="ml-auto flex border border-gray-200 rounded-lg overflow-hidden">
          <button onClick={() => setView("grid")} className={cn("px-3 py-2", view === "grid" ? "bg-gray-900 text-white" : "bg-white text-gray-500 hover:bg-gray-50")}>
            <LayoutGrid size={14} />
          </button>
          <button onClick={() => setView("list")} className={cn("px-3 py-2", view === "list" ? "bg-gray-900 text-white" : "bg-white text-gray-500 hover:bg-gray-50")}>
            <List size={14} />
          </button>
        </div>
      </FilterBar>

      {!selected ? (
        <div className={cn(view === "grid" ? "grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4" : "space-y-3")}>
          {DOCUMENTS_DATA.map(d => (
            <Card key={d.id} className={cn("hover:shadow-md transition-shadow", view === "grid" ? "p-4" : "p-3")}
              onClick={() => setSelected(d)}>
              {view === "grid" ? (
                <div>
                  <div className="flex justify-center mb-4"><FileIcon type={d.type} /></div>
                  {d.hasSummary && (
                    <div className="mb-2 flex items-center gap-1 justify-center">
                      <Sparkles size={10} className="text-gray-400" />
                      <span className="text-[10px] text-gray-400">AI Summary</span>
                    </div>
                  )}
                  <p className="text-xs font-semibold text-gray-800 text-center line-clamp-2 leading-tight mb-2">{d.title}</p>
                  <CategoryBadge label={d.category} />
                  <p className="text-[10px] text-gray-400 mt-2">{d.size} · {d.date}</p>
                  <div className="flex gap-1 mt-3">
                    <button className="flex-1 text-center text-[10px] text-gray-500 hover:text-gray-800 py-1 bg-gray-50 rounded"><Eye size={11} className="mx-auto" /></button>
                    <button className="flex-1 text-center text-[10px] text-gray-500 hover:text-gray-800 py-1 bg-gray-50 rounded"><Download size={11} className="mx-auto" /></button>
                    <button className="flex-1 text-center text-[10px] text-gray-500 hover:text-gray-800 py-1 bg-gray-50 rounded"><Trash2 size={11} className="mx-auto" /></button>
                  </div>
                </div>
              ) : (
                <div className="flex items-center gap-3">
                  <FileIcon type={d.type} />
                  <div className="flex-1 min-w-0">
                    <p className="text-sm font-semibold text-gray-800 truncate">{d.title}</p>
                    <p className="text-xs text-gray-500">{d.category} · {d.uploadedBy} · {d.date}</p>
                  </div>
                  {d.hasSummary && <Sparkles size={13} className="text-gray-400" />}
                  <p className="text-xs text-gray-400">{d.size}</p>
                  <div className="flex gap-1">
                    <button className="p-1.5 hover:bg-gray-100 rounded"><Eye size={13} className="text-gray-500" /></button>
                    <button className="p-1.5 hover:bg-gray-100 rounded"><Download size={13} className="text-gray-500" /></button>
                    <button className="p-1.5 hover:bg-gray-100 rounded"><Trash2 size={13} className="text-gray-500" /></button>
                  </div>
                </div>
              )}
            </Card>
          ))}
        </div>
      ) : (
        /* Document Viewer */
        <div className="grid grid-cols-3 gap-4 h-[calc(100vh-260px)]">
          {/* PDF Preview */}
          <div className="col-span-2 flex flex-col gap-4">
            <div className="flex items-center gap-3">
              <button onClick={() => setSelected(null)} className="flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800">
                <ChevronLeft size={16} /> Back to Documents
              </button>
              <div className="ml-auto flex gap-2">
                <Btn variant="outline" size="sm" icon={Download}>Download</Btn>
                <Btn variant="outline" size="sm" icon={ExternalLink}>Open</Btn>
              </div>
            </div>
            <Card className="flex-1 p-0 overflow-hidden">
              <div className="bg-gray-100 border-b border-gray-200 px-4 py-2 flex items-center gap-3">
                <button className="text-gray-500 hover:text-gray-800"><ChevronLeft size={16} /></button>
                <span className="text-xs text-gray-500">Page 1 of 24</span>
                <button className="text-gray-500 hover:text-gray-800"><ChevronRight size={16} /></button>
                <div className="flex-1" />
                <span className="text-xs text-gray-500">100%</span>
              </div>
              <div className="flex-1 flex items-center justify-center bg-gray-50 min-h-64 p-8">
                <div className="w-full max-w-md bg-white border border-gray-200 rounded shadow-sm p-8 space-y-3">
                  <div className="h-4 bg-gray-200 rounded w-3/4" />
                  <div className="h-3 bg-gray-100 rounded" />
                  <div className="h-3 bg-gray-100 rounded w-5/6" />
                  <div className="h-3 bg-gray-100 rounded w-4/5" />
                  <div className="h-6 mt-4" />
                  <div className="h-3 bg-gray-100 rounded" />
                  <div className="h-3 bg-gray-100 rounded w-3/4" />
                  <div className="grid grid-cols-3 gap-2 mt-4">
                    {[...Array(6)].map((_, i) => <div key={i} className="h-16 bg-gray-100 rounded" />)}
                  </div>
                </div>
              </div>
            </Card>
          </div>

          {/* Sidebar Panel */}
          <div className="flex flex-col gap-3 overflow-y-auto">
            <Card className="p-4">
              <p className="text-xs font-semibold text-gray-700 mb-3">Document Info</p>
              {[
                { label: "Title", val: selected.title },
                { label: "Category", val: selected.category },
                { label: "Uploaded by", val: selected.uploadedBy },
                { label: "Date", val: selected.date },
                { label: "Size", val: selected.size },
                { label: "Type", val: selected.type.toUpperCase() },
              ].map(({ label, val }) => (
                <div key={label} className="flex justify-between py-1.5 text-xs border-b border-gray-50 last:border-0">
                  <span className="text-gray-500">{label}</span>
                  <span className="font-medium text-gray-800 text-right max-w-32 truncate">{val}</span>
                </div>
              ))}
            </Card>

            {selected.hasSummary && (
              <Card className="p-4">
                <div className="flex items-center gap-2 mb-3">
                  <Sparkles size={13} className="text-gray-500" />
                  <p className="text-xs font-semibold text-gray-700">AI Summary</p>
                </div>
                <p className="text-xs text-gray-600 leading-relaxed">
                  This document outlines the curriculum framework for academic year 2026–27. Key changes include updated lab session hours, new elective modules, and revised assessment patterns aligned with NEP 2020 guidelines.
                </p>
              </Card>
            )}

            <Card className="p-4 flex flex-col">
              <div className="flex items-center gap-2 mb-3">
                <Bot size={13} className="text-gray-500" />
                <p className="text-xs font-semibold text-gray-700">Chat with Document</p>
              </div>
              <div className="flex-1 min-h-24 space-y-2 mb-3">
                {chatMsgs.length === 0 && (
                  <p className="text-xs text-gray-400 text-center py-4">Ask anything about this document</p>
                )}
                {chatMsgs.map((m, i) => (
                  <div key={i} className={cn("text-xs rounded-lg px-3 py-2 max-w-[90%]", m.from === "user" ? "bg-gray-900 text-white ml-auto" : "bg-gray-100 text-gray-700")}>
                    {m.text}
                  </div>
                ))}
              </div>
              <div className="flex gap-2">
                <input value={aiChat} onChange={e => setAiChat(e.target.value)} placeholder="Ask a question..."
                  onKeyDown={e => { if (e.key === "Enter" && aiChat.trim()) { setChatMsgs(prev => [...prev, { from: "user", text: aiChat }, { from: "ai", text: "Based on the document, this refers to the updated curriculum structure for the upcoming semester." }]); setAiChat(""); }}}
                  className="flex-1 text-xs border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 outline-none" />
                <button className="w-8 h-8 rounded-lg bg-gray-900 text-white flex items-center justify-center flex-shrink-0">
                  <Send size={13} />
                </button>
              </div>
            </Card>
          </div>
        </div>
      )}
    </div>
  );
}

// ─── Tasks Page ─────────────────────────────────────────────────────────────
function TasksPage({ role }: { role: Role }) {
  const [tab, setTab] = useState(role === "faculty" ? "My Tasks" : "My Tasks");
  const [priority, setPriority] = useState("All Priorities");
  const [status, setStatus] = useState("All Status");
  const [selected, setSelected] = useState<TaskItem | null>(null);
  const [comment, setComment] = useState("");

  const tabs = role === "faculty" ? ["My Tasks"] : ["My Tasks", "Department Tasks"];
  const tasks = tab === "My Tasks"
    ? TASKS_DATA.filter(t => role === "hod" ? t.assignee === "Dr. Anita Sharma" : t.assignee !== "Dr. Anita Sharma").slice(0, 5)
    : TASKS_DATA;

  const canCreate = role !== "faculty";

  return (
    <div className="p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Tasks</h1>
          <p className="text-sm text-gray-500 mt-0.5">Manage and track department tasks</p>
        </div>
        {canCreate && <Btn variant="primary" size="sm" icon={Plus}>Create Task</Btn>}
      </div>

      {/* Summary */}
      <div className="grid grid-cols-4 gap-3 mb-5">
        {[
          { label: "Total", val: TASKS_DATA.length, color: "text-gray-900" },
          { label: "In Progress", val: TASKS_DATA.filter(t => t.status === "In Progress").length, color: "text-gray-700" },
          { label: "Pending", val: TASKS_DATA.filter(t => t.status === "Pending").length, color: "text-gray-500" },
          { label: "Overdue", val: TASKS_DATA.filter(t => t.status === "Overdue").length, color: "text-gray-900" },
        ].map(({ label, val, color }) => (
          <Card key={label} className="p-4 text-center">
            <p className={cn("text-2xl font-bold", color)}>{val}</p>
            <p className="text-xs text-gray-500 mt-0.5">{label}</p>
          </Card>
        ))}
      </div>

      <FilterBar>
        <Input placeholder="Search tasks..." icon={Search} className="flex-1 min-w-40" />
        <Select options={["All Priorities", "High", "Medium", "Low"]} value={priority} onChange={setPriority} />
        <Select options={["All Status", "In Progress", "Pending", "Completed", "Overdue"]} value={status} onChange={setStatus} />
        <Input placeholder="Due date..." icon={Calendar} className="w-36" />
        {role !== "faculty" && <Select options={["All Assignees", ...FACULTY_DATA.map(f => f.name)]} />}
      </FilterBar>

      {tabs.length > 1 && <Tabs tabs={tabs} active={tab} onChange={setTab} />}

      <div className="space-y-2">
        {TASKS_DATA.map(t => (
          <Card key={t.id} className="p-4 hover:shadow-md transition-shadow" onClick={() => setSelected(t)}>
            <div className="flex items-start gap-4">
              <div className="mt-0.5">
                <div className={cn("w-4 h-4 rounded border-2 flex items-center justify-center",
                  t.status === "Completed" ? "bg-gray-800 border-gray-800" : "border-gray-300")}>
                  {t.status === "Completed" && <CheckCircle size={10} className="text-white" />}
                </div>
              </div>
              <div className="flex-1 min-w-0">
                <div className="flex items-start justify-between gap-3 mb-1.5">
                  <p className={cn("text-sm font-semibold text-gray-900", t.status === "Completed" && "line-through text-gray-400")}>{t.title}</p>
                  <div className="flex items-center gap-2 flex-shrink-0">
                    <PriorityBadge priority={t.priority} />
                    <StatusBadge status={t.status} />
                  </div>
                </div>
                <p className="text-xs text-gray-500 mb-2 line-clamp-1">{t.description}</p>
                <div className="flex items-center gap-4">
                  <div className="flex items-center gap-2">
                    <Avatar name={t.assignee} size="sm" />
                    <span className="text-xs text-gray-500">{t.assignee}</span>
                  </div>
                  <span className="text-xs text-gray-400 flex items-center gap-1"><Calendar size={11} /> Due {t.dueDate}</span>
                  <span className="text-xs text-gray-400">{t.department}</span>
                </div>
              </div>
              <div className="flex gap-1 flex-shrink-0">
                {canCreate && <button className="p-1.5 hover:bg-gray-100 rounded-md" onClick={e => e.stopPropagation()}><Pencil size={13} className="text-gray-400" /></button>}
                <button className="p-1.5 hover:bg-gray-100 rounded-md" onClick={e => e.stopPropagation()}><MoreHorizontal size={13} className="text-gray-400" /></button>
              </div>
            </div>
          </Card>
        ))}
      </div>

      {/* Task Detail Drawer */}
      {selected && (
        <Drawer title="Task Details" onClose={() => setSelected(null)} width="w-[560px]">
          <div className="space-y-5">
            <div>
              <div className="flex items-start justify-between gap-3 mb-3">
                <h3 className="text-base font-bold text-gray-900">{selected.title}</h3>
                <div className="flex gap-2 flex-shrink-0">
                  <PriorityBadge priority={selected.priority} />
                  <StatusBadge status={selected.status} />
                </div>
              </div>
              <p className="text-sm text-gray-600 leading-relaxed">{selected.description}</p>
            </div>

            <div className="grid grid-cols-2 gap-3">
              {[
                { label: "Assignee", val: selected.assignee },
                { label: "Department", val: selected.department },
                { label: "Due Date", val: selected.dueDate },
                { label: "Priority", val: selected.priority },
              ].map(({ label, val }) => (
                <div key={label} className="bg-gray-50 rounded-xl p-3">
                  <p className="text-[10px] text-gray-400 uppercase font-semibold mb-1">{label}</p>
                  <p className="text-sm font-medium text-gray-800">{val}</p>
                </div>
              ))}
            </div>

            <div>
              <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Timeline</p>
              <div className="space-y-3">
                {[
                  { event: "Task Created", date: "Jun 15, 2026", by: "Dr. Anita Sharma" },
                  { event: "Assigned to Assignee", date: "Jun 16, 2026", by: "Prof. Rajan Mehta" },
                  { event: "Status: In Progress", date: "Jun 20, 2026", by: selected.assignee },
                ].map((e, i) => (
                  <div key={i} className="flex gap-3 text-xs">
                    <div className="w-2 h-2 rounded-full bg-gray-400 mt-1.5 flex-shrink-0" />
                    <div>
                      <p className="font-medium text-gray-800">{e.event}</p>
                      <p className="text-gray-400">{e.date} · by {e.by}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Comments (2)</p>
              <div className="space-y-3 mb-3">
                {[
                  { who: "Prof. Rajan Mehta", msg: "Please ensure all lab records are included in the inventory.", time: "Jun 18" },
                  { who: "Mr. Vikram Singh", msg: "Will complete by the end of this week.", time: "Jun 19" },
                ].map((c, i) => (
                  <div key={i} className="flex gap-2.5">
                    <Avatar name={c.who} size="sm" />
                    <div className="flex-1 bg-gray-50 rounded-xl p-3">
                      <div className="flex items-center justify-between mb-1">
                        <p className="text-xs font-semibold text-gray-800">{c.who}</p>
                        <p className="text-[10px] text-gray-400">{c.time}</p>
                      </div>
                      <p className="text-xs text-gray-600">{c.msg}</p>
                    </div>
                  </div>
                ))}
              </div>
              <div className="flex gap-2">
                <input value={comment} onChange={e => setComment(e.target.value)} placeholder="Add a comment..."
                  className="flex-1 text-xs border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 outline-none" />
                <Btn variant="primary" size="sm"><Send size={12} /></Btn>
              </div>
            </div>

            {canCreate && (
              <div className="flex gap-3 pt-2 border-t border-gray-100">
                <Btn variant="primary" className="flex-1 justify-center">Update Status</Btn>
                <Btn variant="outline" className="flex-1 justify-center">Reassign</Btn>
              </div>
            )}
          </div>
        </Drawer>
      )}
    </div>
  );
}

// ─── AI Knowledge Page ─────────────────────────────────────────────────────
function AIKnowledgePage() {
  const [query, setQuery] = useState("");
  const [messages, setMessages] = useState<{ from: "user" | "ai"; text: string }[]>([
    { from: "ai", text: "Hello! I'm your AI Knowledge Assistant. I can answer questions about your department documents, announcements, meetings, and more. What would you like to know?" }
  ]);
  const [activeHistory, setActiveHistory] = useState(0);

  const suggested = [
    "Summarize this month's announcements",
    "What are the pending task deadlines?",
    "Generate minutes for the June 20 meeting",
    "Who has the highest workload this month?",
    "List all uploaded documents in Academic category",
    "What decisions were made in the budget meeting?",
  ];

  const histories = [
    { title: "Faculty Workload Analysis", date: "Jun 29" },
    { title: "NAAC Document Review", date: "Jun 28" },
    { title: "Task Deadline Summary", date: "Jun 27" },
    { title: "Meeting Minutes Request", date: "Jun 25" },
    { title: "Announcement Summary", date: "Jun 24" },
  ];

  const sendMsg = () => {
    if (!query.trim()) return;
    setMessages(prev => [
      ...prev,
      { from: "user", text: query },
      { from: "ai", text: `Based on the department knowledge base, here's what I found regarding "${query}": The relevant documents and records indicate that this relates to ongoing department activities. I've cross-referenced 3 documents, 2 meetings, and 5 tasks to provide this response.` }
    ]);
    setQuery("");
  };

  return (
    <div className="h-[calc(100vh-64px)] flex">
      {/* Left Panel */}
      <div className="w-64 border-r border-gray-200 bg-white flex flex-col flex-shrink-0">
        <div className="p-4 border-b border-gray-100">
          <Btn variant="primary" size="sm" className="w-full justify-center" icon={Plus}>New Conversation</Btn>
        </div>
        <div className="p-4 border-b border-gray-100">
          <p className="text-[10px] font-semibold text-gray-400 uppercase tracking-wide mb-3">Recent Conversations</p>
          <div className="space-y-1">
            {histories.map((h, i) => (
              <button key={i} onClick={() => setActiveHistory(i)}
                className={cn("w-full text-left px-3 py-2.5 rounded-lg text-xs transition-colors",
                  i === activeHistory ? "bg-gray-900 text-white" : "text-gray-600 hover:bg-gray-50")}>
                <p className="font-medium truncate">{h.title}</p>
                <p className={cn("text-[10px] mt-0.5", i === activeHistory ? "text-gray-400" : "text-gray-400")}>{h.date}</p>
              </button>
            ))}
          </div>
        </div>
        <div className="p-4 flex-1 overflow-y-auto">
          <p className="text-[10px] font-semibold text-gray-400 uppercase tracking-wide mb-3">Suggested Questions</p>
          <div className="space-y-2">
            {suggested.map((s, i) => (
              <button key={i} onClick={() => setQuery(s)}
                className="w-full text-left text-xs text-gray-600 hover:bg-gray-50 px-3 py-2 rounded-lg border border-gray-100 leading-snug transition-colors">
                {s}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Center Panel */}
      <div className="flex-1 flex flex-col bg-gray-50">
        <div className="p-4 bg-white border-b border-gray-200 flex items-center gap-3">
          <Brain size={20} className="text-gray-600" />
          <div>
            <p className="text-sm font-bold text-gray-900">AI Knowledge Assistant</p>
            <p className="text-xs text-gray-400">Powered by department knowledge base · {DOCUMENTS_DATA.length} docs · {MEETINGS_DATA.length} meetings</p>
          </div>
          <div className="ml-auto flex gap-2">
            <Btn variant="ghost" size="sm" icon={RefreshCw}>Clear</Btn>
            <Btn variant="ghost" size="sm" icon={Download}>Export</Btn>
          </div>
        </div>

        <div className="flex-1 overflow-y-auto p-6 space-y-5">
          {messages.map((m, i) => (
            <div key={i} className={cn("flex gap-3", m.from === "user" ? "flex-row-reverse" : "flex-row")}>
              {m.from === "ai" ? (
                <div className="w-8 h-8 rounded-full bg-gray-900 flex items-center justify-center flex-shrink-0">
                  <Bot size={14} className="text-white" />
                </div>
              ) : (
                <Avatar name="Dr. Anita Sharma" size="sm" className="flex-shrink-0" />
              )}
              <div className={cn("max-w-lg rounded-2xl px-4 py-3 text-sm leading-relaxed",
                m.from === "user" ? "bg-gray-900 text-white" : "bg-white border border-gray-200 text-gray-700")}>
                {m.text}
              </div>
            </div>
          ))}
        </div>

        <div className="p-4 bg-white border-t border-gray-200">
          <div className="flex gap-3 items-end">
            <div className="flex-1 border border-gray-200 rounded-xl bg-gray-50 flex items-end gap-2 px-4 py-3">
              <textarea value={query} onChange={e => setQuery(e.target.value)}
                onKeyDown={e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMsg(); }}}
                placeholder="Ask anything about your department knowledge..."
                className="flex-1 text-sm bg-transparent outline-none resize-none text-gray-800 placeholder-gray-400 max-h-32" rows={1} />
              <div className="flex gap-2 flex-shrink-0">
                <button className="text-gray-400 hover:text-gray-700 p-1"><Paperclip size={15} /></button>
              </div>
            </div>
            <button onClick={sendMsg} className="w-11 h-11 rounded-xl bg-gray-900 text-white flex items-center justify-center hover:bg-gray-700 transition-colors">
              <Send size={17} />
            </button>
          </div>
          <p className="text-[10px] text-gray-400 text-center mt-2">AI may make mistakes. Verify important information from source documents.</p>
        </div>
      </div>

      {/* Right Panel */}
      <div className="w-72 border-l border-gray-200 bg-white flex flex-col flex-shrink-0 overflow-y-auto">
        <div className="p-4 border-b border-gray-100">
          <p className="text-xs font-bold text-gray-800 mb-1">Knowledge Sources</p>
          <p className="text-[10px] text-gray-400">Referenced in this conversation</p>
        </div>

        {/* Confidence */}
        <div className="p-4 border-b border-gray-100">
          <div className="flex items-center justify-between mb-2">
            <p className="text-xs font-semibold text-gray-700">Response Confidence</p>
            <span className="text-xs font-bold text-gray-800">92%</span>
          </div>
          <ProgressBar value={92} max={100} />
          <p className="text-[10px] text-gray-400 mt-1.5">Based on 3 high-confidence documents</p>
        </div>

        {/* Referenced Documents */}
        <div className="p-4 border-b border-gray-100">
          <p className="text-[10px] font-semibold text-gray-400 uppercase tracking-wide mb-3">Referenced Documents</p>
          <div className="space-y-2">
            {DOCUMENTS_DATA.slice(0, 3).map(d => (
              <div key={d.id} className="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                <FileIcon type={d.type} />
                <div className="min-w-0">
                  <p className="text-xs font-medium text-gray-800 truncate">{d.title}</p>
                  <p className="text-[10px] text-gray-400">{d.category}</p>
                </div>
                <ExternalLink size={11} className="text-gray-300 flex-shrink-0" />
              </div>
            ))}
          </div>
        </div>

        {/* Referenced Meetings */}
        <div className="p-4 border-b border-gray-100">
          <p className="text-[10px] font-semibold text-gray-400 uppercase tracking-wide mb-3">Referenced Meetings</p>
          <div className="space-y-2">
            {MEETINGS_DATA.slice(0, 2).map(m => (
              <div key={m.id} className="p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                <p className="text-xs font-medium text-gray-800 line-clamp-1">{m.title}</p>
                <p className="text-[10px] text-gray-400">{m.date}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Related Files */}
        <div className="p-4">
          <p className="text-[10px] font-semibold text-gray-400 uppercase tracking-wide mb-3">Related Announcements</p>
          <div className="space-y-2">
            {ANNOUNCEMENTS_DATA.slice(0, 2).map(a => (
              <div key={a.id} className="p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                <p className="text-xs font-medium text-gray-800 line-clamp-2">{a.title}</p>
                <p className="text-[10px] text-gray-400">{a.date}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

// ─── Reports Page (HOD only) ────────────────────────────────────────────────
function ReportsPage() {
  const [period, setPeriod] = useState("Last 6 Months");

  return (
    <div className="p-6 space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Reports & Analytics</h1>
          <p className="text-sm text-gray-500 mt-0.5">Comprehensive department performance metrics</p>
        </div>
        <div className="flex gap-3">
          <Select options={["Last 7 Days", "Last 30 Days", "Last 6 Months", "This Year"]} value={period} onChange={setPeriod} />
          <Btn variant="outline" size="sm" icon={Download}>Export PDF</Btn>
          <Btn variant="outline" size="sm" icon={Download}>Export Excel</Btn>
        </div>
      </div>

      {/* Summary KPIs */}
      <div className="grid grid-cols-4 gap-4">
        <StatCard label="Faculty Workload Avg." value="21.4 hrs" sub="↑ 8% vs. last period" icon={Users} />
        <StatCard label="Task Completion Rate" value="76%" sub="↑ 12% vs. last period" icon={CheckSquare} />
        <StatCard label="Meeting Efficiency" value="84%" sub="Agenda coverage rate" icon={Video} />
        <StatCard label="AI Usage" value="234" sub="queries this month" icon={Brain} />
      </div>

      {/* Charts Row 1 */}
      <div className="grid grid-cols-2 gap-4">
        <ChartCard title="Faculty Workload by Month (hrs/week)" action={<Btn variant="ghost" size="sm" icon={Download}>Export</Btn>}>
          <ResponsiveContainer width="100%" height={220}>
            <RBar data={workloadData} barSize={28}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 11, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 11, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={28} />
              <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8, border: "1px solid #E4E4E7" }} />
              <Bar dataKey="hours" fill="#27272A" radius={[4, 4, 0, 0]} />
            </RBar>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Task Completion vs Pending" action={<Btn variant="ghost" size="sm" icon={Download}>Export</Btn>}>
          <ResponsiveContainer width="100%" height={220}>
            <RArea data={taskCompletionData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 11, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 11, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={28} />
              <Tooltip contentStyle={{ fontSize: 11, borderRadius: 8, border: "1px solid #E4E4E7" }} />
              <Area type="monotone" dataKey="completed" stroke="#27272A" fill="#E4E4E7" strokeWidth={2} />
              <Area type="monotone" dataKey="pending" stroke="#A1A1AA" fill="#F4F4F5" strokeWidth={2} />
              <Legend iconType="line" iconSize={12} wrapperStyle={{ fontSize: 11 }} />
            </RArea>
          </ResponsiveContainer>
        </ChartCard>
      </div>

      {/* Charts Row 2 */}
      <div className="grid grid-cols-3 gap-4">
        <ChartCard title="Document Uploads by Month">
          <ResponsiveContainer width="100%" height={180}>
            <RLine data={uploadTrendData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={24} />
              <Tooltip contentStyle={{ fontSize: 10, borderRadius: 8 }} />
              <Line type="monotone" dataKey="docs" stroke="#52525B" strokeWidth={2} dot={{ r: 3, fill: "#52525B" }} />
            </RLine>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Meeting Activity">
          <ResponsiveContainer width="100%" height={180}>
            <RBar data={meetingActivityData} barSize={18}>
              <CartesianGrid strokeDasharray="3 3" stroke="#F4F4F5" vertical={false} />
              <XAxis dataKey="month" tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fontSize: 10, fill: "#A1A1AA" }} axisLine={false} tickLine={false} width={24} />
              <Tooltip contentStyle={{ fontSize: 10, borderRadius: 8 }} />
              <Bar dataKey="meetings" fill="#52525B" radius={[4, 4, 0, 0]} />
            </RBar>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Dept. Faculty Distribution">
          <ResponsiveContainer width="100%" height={180}>
            <RPie>
              <Pie data={deptDistData} cx="50%" cy="50%" innerRadius={40} outerRadius={70} dataKey="value" paddingAngle={2} label={({ name, percent }) => `${(percent * 100).toFixed(0)}%`} labelLine={false}>
                {deptDistData.map((_, i) => <Cell key={i} fill={CHART_COLORS[i % CHART_COLORS.length]} />)}
              </Pie>
              <Tooltip contentStyle={{ fontSize: 10, borderRadius: 8 }} />
            </RPie>
          </ResponsiveContainer>
          <div className="flex flex-wrap gap-x-3 gap-y-1 mt-2">
            {deptDistData.map((d, i) => (
              <div key={d.name} className="flex items-center gap-1.5 text-[10px] text-gray-500">
                <div className="w-2 h-2 rounded-full flex-shrink-0" style={{ background: CHART_COLORS[i] }} />
                {d.name}
              </div>
            ))}
          </div>
        </ChartCard>
      </div>

      {/* Table Report */}
      <Card className="p-5">
        <SectionHeader title="Faculty Performance Summary" subtitle="Individual metrics for all faculty members" action={
          <Btn variant="outline" size="sm" icon={Download}>Export</Btn>
        } />
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="border-b border-gray-200">
                {["Faculty", "Department", "Workload (hrs)", "Tasks Assigned", "Tasks Completed", "Meetings Attended", "Docs Uploaded", "Score"].map(h => (
                  <th key={h} className="px-3 py-2.5 text-left text-xs font-semibold text-gray-500">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-50">
              {FACULTY_DATA.slice(0, 6).map((f, i) => (
                <tr key={f.id} className="hover:bg-gray-50">
                  <td className="px-3 py-3">
                    <div className="flex items-center gap-2">
                      <Avatar name={f.name} size="sm" />
                      <span className="text-sm font-medium text-gray-800">{f.name}</span>
                    </div>
                  </td>
                  <td className="px-3 py-3 text-sm text-gray-600">{f.department}</td>
                  <td className="px-3 py-3 text-sm text-gray-700">{18 + i * 2} hrs</td>
                  <td className="px-3 py-3 text-sm text-gray-700">{4 + i}</td>
                  <td className="px-3 py-3 text-sm text-gray-700">{3 + i}</td>
                  <td className="px-3 py-3 text-sm text-gray-700">{6 + i}</td>
                  <td className="px-3 py-3 text-sm text-gray-700">{8 + i}</td>
                  <td className="px-3 py-3">
                    <div className="flex items-center gap-2">
                      <ProgressBar value={75 + i * 3} max={100} />
                      <span className="text-xs font-semibold text-gray-700">{75 + i * 3}%</span>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>
  );
}

